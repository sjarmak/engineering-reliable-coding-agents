{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-reliability/reference_context/benchmarks/schema.json",
  "title": "Coding-agent benchmark catalog",
  "description": "Array of benchmark entries merged from swe-family.json and agentic-other.json. Missing source fields are the literal string 'unknown'.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "slug",
      "name",
      "family",
      "url",
      "paper_url",
      "what_it_measures",
      "task_source",
      "metric",
      "contamination_status",
      "maintenance_state",
      "harness_lessons",
      "notes"
    ],
    "properties": {
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "description": "Stable id; matches cards/<slug>.md filename."
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "family": {
        "type": "string",
        "minLength": 1,
        "description": "Benchmark lineage/category, free text."
      },
      "url": {
        "type": "string",
        "minLength": 1
      },
      "paper_url": {
        "type": "string",
        "minLength": 1
      },
      "what_it_measures": {
        "type": "string",
        "minLength": 1
      },
      "task_source": {
        "type": "string",
        "minLength": 1
      },
      "metric": {
        "type": "string",
        "minLength": 1
      },
      "contamination_status": {
        "type": "string",
        "minLength": 1
      },
      "maintenance_state": {
        "type": "string",
        "minLength": 1
      },
      "harness_lessons": {
        "type": "string",
        "minLength": 1
      },
      "notes": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
