{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engineering Reliable Coding Agents practice catalog",
  "type": "array",
  "minItems": 206,
  "maxItems": 206,
  "items": {
    "type": "object",
    "required": [
      "practice_id",
      "id",
      "name",
      "practice",
      "rationale",
      "boundary_conditions",
      "chapter",
      "treatment",
      "evidence"
    ],
    "properties": {
      "practice_id": {
        "type": "string",
        "pattern": "^ERCA-[0-9]{3}$"
      },
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "name": {
        "type": "string"
      },
      "practice": {
        "type": "string"
      },
      "rationale": {
        "type": "string"
      },
      "boundary_conditions": {
        "type": "string"
      },
      "transfers_to": {
        "type": "string"
      },
      "chapter": {
        "type": "integer",
        "minimum": 1,
        "maximum": 19
      },
      "chapter_title": {
        "type": "string"
      },
      "treatment": {
        "enum": [
          "developed_in_manuscript",
          "companion_only"
        ]
      },
      "thin_support": {
        "type": "boolean"
      },
      "evidence": {
        "type": "array"
      },
      "corroborating_material": {
        "type": "array"
      }
    }
  }
}
