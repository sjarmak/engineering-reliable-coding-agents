{
  "schema_version": 1,
  "source_lane": "open_bibliography_dblp_title_census",
  "purpose": "Credential-free title census over named DBLP venue streams. This provides replacement evidence while Scopus is unavailable, but it is not publisher-native and is not treated as equivalent to Scopus title/abstract/keyword retrieval.",
  "years": [
    2018,
    2026
  ],
  "metadata_boundary": "Retain DBLP publication identifiers, titles, years, and DOI values. DBLP metadata is released under CC0 1.0.",
  "method_boundary": "Each topic is a conjunction of title groups. A title matches when it contains at least one literal phrase from every required group. DBLP does not supply abstracts, so this lane cannot reproduce Scopus TITLE-ABS-KEY behavior.",
